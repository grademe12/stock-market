# Bind dashboards only to this mini PC's Tailscale IPv4.
OBSERVABILITY_BIND_ADDRESS=100.x.y.z

# Tailscale IPv4 of the GCE backend VM.
BACKEND_TAILSCALE_IP=100.x.y.z

# Store the real password in this ignored file, not in .env or Compose YAML.
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password
