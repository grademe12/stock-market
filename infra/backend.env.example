DATABASE_ENGINE=postgresql
POSTGRES_DB=stock_market
POSTGRES_USER=stock_market
POSTGRES_PASSWORD=loaded-from-secret-manager
POSTGRES_HOST=local-db.example-tailnet.ts.net
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
DJANGO_SECRET_KEY=loaded-from-secret-manager
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=stock-market-gce.example-tailnet.ts.net,stock-market-gce
TRADE_EXECUTION_LOG_ENABLED=0
