# Address reachable from the runner container. For a backend running on the
# Docker host, use host.docker.internal (and --add-host on Linux if needed).
BACKEND_BASE_URL=http://host.docker.internal:8000

# Runner/container scheduling settings.
TICK_INTERVAL_MS=1000
REQUEST_TIMEOUT_MS=5000
RUNNER_STATUS_LOG_INTERVAL_TICKS=60

# Optional scope. The number of active TraderProfile records is the source of
# truth; MAX_TRADERS only caps this container's selected profiles.
MAX_TRADERS=
TRADER_IDS=
