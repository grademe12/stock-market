# Copied to postgresql.conf on the local database machine.
# Docker publishes port 5432 only on POSTGRES_BIND_ADDRESS.
listen_addresses = '*'
port = 5432

password_encryption = 'scram-sha-256'
timezone = 'Asia/Seoul'
log_timezone = 'Asia/Seoul'
log_line_prefix = '%m [%p] user=%u db=%d client=%h '
log_connections = on
log_disconnections = on
log_checkpoints = on
